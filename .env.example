# 이 파일을 .env.local로 복사해 값을 채우세요. 모두 서버에서만 읽습니다.
# NEXT_PUBLIC_ 접두사를 붙이지 마세요. 붙이면 브라우저로 노출됩니다.

# Claude API 키. 비워 두면 AI 기능 없이 판정과 기본 안내만 동작합니다.
ANTHROPIC_API_KEY=

# 사용할 모델. 비워 두면 claude-sonnet-5-5를 씁니다.
ANTHROPIC_MODEL=

# AI 기능 시연용 접근 코드. 비워 두면 AI 라우트는 503으로 닫혀 있습니다.
DEMO_ACCESS_CODE=

# AI 호출 제한: IP당 1분에 허용할 AI 요청 수. 비워 두면 30회를 씁니다.
# 1 이상의 정수만 쓸 수 있고, 숫자가 아니거나 1 미만이면 30회로 돌아갑니다.
# 같은 네트워크(같은 IP)에서 여러 명이 함께 쓰면 합쳐서 세므로 넉넉히 두세요.
# 서버가 시작될 때 읽으므로 값을 바꾸면 서버를 다시 시작하세요.
AI_RATE_LIMIT_PER_MINUTE=
